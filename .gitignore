node_modules/
dist/
.tsbuild/
.turbo/
*.tsbuildinfo

# Declaration/source maps are always tsc output — never hand-written — so a
# stray emit into src/ can't be committed again. (`.d.ts` itself is NOT ignored:
# global.d.ts, env.d.ts and vendor shims like alpinejs-morph.d.ts are real
# sources with no sibling .ts, and a blanket rule would silently drop them.
# Emits are kept out of src/ by each package's outDir.)
packages/*/src/**/*.d.ts.map
packages/*/src/**/*.js.map
.DS_Store

# Built asset bundles — regenerate with `bun run build` in the app. Tracking
# them put a 137K CSS diff in every PR that touched a style, and let a stale
# bundle ship silently. Scoped to apps/, deliberately: a create-zerotal
# template may legitimately need to ship a starter public/css/app.css, and a
# `**/` pattern here would silently drop it from the scaffold.
apps/*/public/css/app.css
apps/*/public/js/app.js
apps/*/public/js/app.js.map
*.zerotal/
.zerotal/
**/.zerotal/
**/public/assets/
.tmp-*
*.tmp.log
*/.claude/
.claude/
**/.claude/
.fuse_hidden*
**/.fuse_hidden*

# Staging area for clutter pending deletion — never track.
_to_delete/
_fable_tmp/

# Rebrand working set — reference material only, never shipped or published.
.meta/
# Generated by typecheck:tests (should never be committed)
tsconfig.spec.json

# Environment files — never commit secrets. Use .env.example for templates.
.env
**/.env
.env.*
!.env.example
!**/.env.example
!.env.test

# API reference — generated by `bun run docs:api` (TypeDoc). Build artifact.
docs/api/
typedoc.json
packages/*/typedoc.json

# Application log trail — written by the logger's always-on file sink.
storage/logs/
**/storage/logs/

# …but not a test fixture's copy. A fixture is an input to a test, not runtime
# data, and the rules above are broad enough to swallow one — which is how the
# `logs` tool's fixtures were left untracked, passing locally where the files
# existed and failing on a fresh CI checkout where they did not. Both lines are
# needed: git cannot re-include a file whose parent directory is excluded, so the
# directory has to be un-excluded first.
!**/__fixtures__/**/storage/logs/
!**/__fixtures__/**/storage/logs/**

# Scratch storage roots created by test suites.
.tmp-*storage*/

# Uploaded files and other app-written storage. The directory structure is
# scaffolded; its contents are runtime data.
**/storage/app/

# Local SQLite databases. Content authored through an app's admin UI lives here;
# it is runtime data, rebuilt with `bun run fresh && bun run seed`.
**/database/*.sqlite
**/database/*.sqlite-shm
**/database/*.sqlite-wal

# Database snapshots written by `bun run db:backup`.
**/storage/backups/

# Release tarballs staged by scripts/publish-packages.ts
.release-tarballs/

# Working documents — proposals, roadmaps, audit notes, field reports.
# These are drafting material, not part of the published project, and one of them
# reached the public repository before this rule existed. Everything under
# .planning/ stays local; nothing in it is ever committed.
.planning/
apps/docs/.docs-examples-*/

# `--outfile=/dev/null` on Windows creates a literal file called `nul`, because
# the shell has no such device. It blocks a commit the first time and is recreated
# by the next build, so it is ignored rather than repeatedly deleted.
nul

# The site gate's state — never committed.
#
# This is the whole reason the feature exists in the app rather than in a reverse
# proxy: a gate held in version control is one that gets deployed and forgotten,
# and quietly password-protects a live site at launch. It is per-environment
# state, like a log, not configuration.
storage/framework/gate.json
**/storage/framework/gate.json
