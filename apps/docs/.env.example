APP_NAME="Zerotal Docs"
APP_ENV=local
# Generate with: bun zt key:generate (or: openssl rand -base64 32)
APP_KEY=
APP_DEBUG=true
# Canonical URLs, the sitemap, the feed and OG tags are all built from this.
# Set it in production, or the sitemap advertises localhost.
APP_URL=http://localhost:3000

# Posts written at /admin live here. The schema is built from the models on boot
# in local/dev (config/database.ts); production runs `zt migrate` instead.
DATABASE_URL=./database/db.sqlite

SESSION_DRIVER=cookie
SESSION_COOKIE=zerotal_docs_session

# The author account created by `bun run seed` — it can publish to the live site.
# Required outside local: the seeder refuses to run without it, and refuses the
# literal "password". Left blank here so a copied .env cannot ship a known one.
ADMIN_NAME="Zerotal"
ADMIN_EMAIL=admin@zerotal.dev
ADMIN_PASSWORD=

# Number of trusted reverse proxies in front of the app. The sign-in rate limit
# keys on the client IP, and X-Forwarded-For is client-writable — without this
# count every visitor behind a load balancer shares one bucket.
TRUSTED_PROXIES=0
