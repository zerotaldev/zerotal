{
  "name": "zerotal",
  "version": "1.5.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "bun --filter='*' run test",
    "typecheck": "bun --filter='*' run typecheck",
    "typecheck:tests": "bun run scripts/typecheck-tests.ts",
    "dev": "bun --filter='*' run dev",
    "lint:packages": "bun run scripts/lint-packages.ts",
    "lint:packages:ci": "bun run scripts/lint-packages.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ci": "bun run scripts/lint.ts",
    "link:all": "bun run scripts/link-all.ts",
    "api:surface": "bun run scripts/api-surface.ts",
    "api:surface:check": "bun run scripts/api-surface.ts --check",
    "cast:check": "bun run scripts/cast-audit.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:build": "bun run docs:api && cd apps/docs && bun run build",
    "docs:api": "bun run scripts/api/build-api-docs.ts",
    "docs:components": "bun run scripts/generate-docs.ts",
    "docs:components:check": "bun run scripts/generate-docs.ts --check",
    "docs:coverage": "bun run scripts/docs-coverage.ts",
    "docs:coverage:update": "bun run scripts/docs-coverage.ts --update",
    "docs:api:watch": "bun run scripts/api/collect-entrypoints.ts && bunx typedoc --options typedoc.json --watch"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@zerotal/core": "workspace:*",
    "@types/bun": "^1.3.14",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.10.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
