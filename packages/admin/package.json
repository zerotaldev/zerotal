{
  "name": "@zerotal/admin",
  "version": "1.14.2",
  "license": "MIT",
  "maturity": "stable",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth/index.ts",
    "./testing": "./src/testing.ts"
  },
  "files": [
    "CHANGELOG.md",
    "api-surface.md",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.spec.ts",
    "!src/**/__fixtures__/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zerotal/cache": "workspace:*",
    "@zerotal/core": "workspace:*",
    "@zerotal/flow": "workspace:*",
    "@zerotal/flow-ui": "workspace:*",
    "@zerotal/validator": "workspace:*"
  },
  "devDependencies": {
    "@zerotal/orm": "workspace:*",
    "@zerotal/auth": "workspace:*",
    "@zerotal/queue": "workspace:*"
  },
  "peerDependencies": {
    "@zerotal/orm": "^1.0.0",
    "@zerotal/auth": "^1.0.0",
    "@zerotal/queue": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@zerotal/orm": {
      "optional": true
    },
    "@zerotal/auth": {
      "optional": true
    },
    "@zerotal/queue": {
      "optional": true
    }
  },
  "description": "Auto-generated admin panel (resources, tables, forms, widgets) for Zerotal apps.",
  "keywords": [
    "zerotal",
    "bun",
    "typescript",
    "framework",
    "admin",
    "crud",
    "panel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerotaldev/zerotal.git",
    "directory": "packages/admin"
  },
  "homepage": "https://github.com/zerotaldev/zerotal/tree/main/packages/admin#readme",
  "bugs": "https://github.com/zerotaldev/zerotal/issues"
}
