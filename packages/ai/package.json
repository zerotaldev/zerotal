{
  "name": "@zerotal/ai",
  "version": "1.7.5",
  "license": "MIT",
  "maturity": "experimental",
  "maturityReview": "1.9.0",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "CHANGELOG.md",
    "api-surface.md",
    "src",
