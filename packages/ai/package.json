    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "description": "Provider-agnostic AI generation for Zerotal — text, streaming, structured output, typed tools, and an agent loop.",
  "keywords": [
    "zerotal",
    "bun",
    "typescript",
    "framework",
    "ai",
    "llm",
    "anthropic",
    "claude",
    "openai",
    "ollama"
