{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "rootDir": "..",
    "outDir": "./.tsbuild",
    "tsBuildInfoFile": "./.tsbuild/.tsbuildinfo",
    "paths": {
      "@zerotal/core": ["../core/src/index.ts"],
      "@zerotal/core/*": ["../core/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", ".tsbuild", "**/*.test.ts", "**/*.test.tsx"]
}
