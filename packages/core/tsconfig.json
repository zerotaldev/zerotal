{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./.tsbuild",
    "tsBuildInfoFile": "./.tsbuild/.tsbuildinfo",
    "jsx": "react-jsx",
    "jsxImportSource": "@zerotal/core"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", ".tsbuild", "**/*.test.ts", "**/*.test.tsx"]
}
