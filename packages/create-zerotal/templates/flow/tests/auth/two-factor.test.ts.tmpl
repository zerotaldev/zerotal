import { afterAll, beforeAll, beforeEach, describe, expect, test } from "bun:test";
import { PASSWORD_CONFIRMED_AT_KEY, TwoFactorService, loginThrottle } from "zerotal/auth";
import { refreshDatabase, type TestApp } from "zerotal/testing";
import { User } from "../../app/models/User";
import { claimTwoFactorStep } from "../../app/auth/two-factor";
import { FACTORY_PASSWORD, UserFactory } from "../../database/factories/UserFactory";
import { Browser, bootApp } from "../support";
import { assertPage, attributes, textOf } from "../html";

let app: TestApp;
// The codes an authenticator app would show, made from the same secret.
const authenticator = new TwoFactorService();

beforeAll(async () => {
  app = await bootApp();
});
afterAll(() => app.close());
beforeEach(() => {
  app.actingAsGuest();
  loginThrottle.reset();
});

/** A user with two-factor already on, and the plain recovery codes they were shown. */
async function userWithTwoFactor() {
  const secret = authenticator.generateSecret();
  const { plain, hashed } = authenticator.generateRecoveryCodes();
  const user = await UserFactory.create();
  user.twoFactorSecret = secret;
  user.twoFactorRecoveryCodes = JSON.stringify(hashed);
  user.twoFactorConfirmedAt = new Date();
  await user.save();
  return { user, secret, recoveryCodes: plain };
}

/** Signed in with the password, so the next thing asked for is the code. */
async function signInWithPassword(email: string): Promise<Browser> {
  const browser = new Browser(app);
  const res = await browser.post("/login", { email, password: FACTORY_PASSWORD });
  res.assertRedirect("/two-factor/challenge");
  return browser;
}

describe("setting up two-factor", () => {
  refreshDatabase();

  test("turns two-factor on with a code from the app", async () => {
    const user = await UserFactory.create();
    const browser = new Browser(app);
    await browser.post("/login", { email: user.email, password: FACTORY_PASSWORD });
    await browser.post("/confirm-password", { password: FACTORY_PASSWORD });

    (await browser.post("/settings/two-factor")).assertRedirect("/settings/two-factor");
    const setup = (await browser.get("/settings/two-factor")).assertSee("<svg");
    // The key, as the page shows it for typing in by hand.
    const secret = (textOf(setup, "data-two-factor-secret") ?? "").replace(/\s/g, "");
    expect(secret).not.toBe("");

    const res = await browser.post("/settings/two-factor/confirm", {
      code: authenticator.generateCode(secret),
    });
    res.assertRedirect("/settings/two-factor");

    const page = await browser.get("/settings/two-factor");
    expect(textOf(page, "data-two-factor-status")).toBe("On");
    // Shown once, straight after they were made.
    expect(attributes(page, "data-recovery-code")).toHaveLength(8);
    expect(
      attributes(await browser.get("/settings/two-factor"), "data-recovery-code"),
    ).toHaveLength(0);
    expect((await User.find(user.id))?.hasTwoFactorEnabled()).toBe(true);
  });

  test("the code that turned two-factor on can't then sign in", async () => {
    const user = await UserFactory.create();
    const browser = new Browser(app);
    await browser.post("/login", { email: user.email, password: FACTORY_PASSWORD });
    await browser.post("/confirm-password", { password: FACTORY_PASSWORD });
    await browser.post("/settings/two-factor");
    const setup = (await browser.get("/settings/two-factor")).assertSee("<svg");
    const secret = (textOf(setup, "data-two-factor-secret") ?? "").replace(/\s/g, "");
    const code = authenticator.generateCode(secret);
    (await browser.post("/settings/two-factor/confirm", { code })).assertRedirect(
      "/settings/two-factor",
    );

    const other = await signInWithPassword(user.email);
    (await other.post("/two-factor/challenge", { code })).assertInvalid(["code"]);
    (await other.get("/dashboard")).assertRedirect("/login");
  });

  test("rejects a wrong code during setup, and saves nothing", async () => {
    const user = await UserFactory.create();
    const browser = new Browser(app);
    await browser.post("/login", { email: user.email, password: FACTORY_PASSWORD });
    await browser.post("/confirm-password", { password: FACTORY_PASSWORD });
    await browser.post("/settings/two-factor");

    const res = await browser.post("/settings/two-factor/confirm", { code: "000000" });

    res.assertInvalid(["code"]);
    expect((await User.find(user.id))?.hasTwoFactorEnabled()).toBe(false);
  });

  test("pressing Enter in the code field turns it on rather than cancelling", async () => {
    const user = await UserFactory.create();
    const browser = new Browser(app);
    await browser.post("/login", { email: user.email, password: FACTORY_PASSWORD });
    await browser.post("/confirm-password", { password: FACTORY_PASSWORD });
    await browser.post("/settings/two-factor");
    const html = (await browser.get("/settings/two-factor")).assertOk().text();

    // A browser submits a form from a text field with the form's default button: the first
    // submit button that belongs to it. A button with a `form` attribute belongs elsewhere.
    const form = html.match(/<form[^>]*action="\/settings\/two-factor\/confirm"[\s\S]*?<\/form>/);
    const buttons = [...(form?.[0] ?? "").matchAll(/<button([^>]*)>([\s\S]*?)<\/button>/g)];
    const owned = buttons.filter(
      ([, attrs]) => !/\stype="button"/.test(attrs!) && !/\sform=/.test(attrs!),
    );
    expect(owned[0]?.[2]?.trim()).toBe("Turn on");
  });

  test("never shows the secret or the recovery codes to the page", async () => {
    const { user } = await userWithTwoFactor();

    const fresh = (await User.find(user.id))!;

    for (const path of ["/settings/profile", "/settings/two-factor", "/dashboard"]) {
      const page = (
        await app
          .actingAs(user)
          .withSession({ [PASSWORD_CONFIRMED_AT_KEY]: Date.now() })
          .get(path)
      ).assertOk();
      page.assertDontSee(fresh.twoFactorSecret!);
      page.assertDontSee(fresh.twoFactorRecoveryCodes!);
      page.assertDontSee(fresh.password);
    }
  });
});

describe("signing in with two-factor", () => {
  refreshDatabase();

  test("asks for a code at sign-in once two-factor is on", async () => {
    const { user } = await userWithTwoFactor();
    const browser = await signInWithPassword(user.email);

    // Password alone is not a session: every signed-in page still sees a guest.
    (await browser.get("/dashboard")).assertRedirect("/login");
    assertPage(await browser.get("/two-factor/challenge"), "Two-factor authentication");
  });

  test("signs in with a valid code", async () => {
    const { user, secret } = await userWithTwoFactor();
    const browser = await signInWithPassword(user.email);

    (
      await browser.post("/two-factor/challenge", { code: authenticator.generateCode(secret) })
    ).assertRedirect("/dashboard");
    (await browser.get("/dashboard")).assertOk();
  });

  test("refuses a code that already signed someone in", async () => {
    const { user, secret } = await userWithTwoFactor();
    const code = authenticator.generateCode(secret);

    const first = await signInWithPassword(user.email);
    (await first.post("/two-factor/challenge", { code })).assertRedirect("/dashboard");

    // Still inside its 30 seconds, but it has been used: a code works once.
    const second = await signInWithPassword(user.email);
    (await second.post("/two-factor/challenge", { code })).assertInvalid(["code"]);
    (await second.get("/dashboard")).assertRedirect("/login");
  });

  test("claims a code's step once, however many requests race for it", async () => {
    const { user, secret } = await userWithTwoFactor();
    const check = authenticator.verifyCodeWithCounter(secret, authenticator.generateCode(secret));
    expect(check.valid).toBe(true);
    const step = check.valid ? check.counter : 0;

    // The claim is one conditional update, so of several at once exactly one changes the row.
    const claims = await Promise.all([1, 2, 3].map(() => claimTwoFactorStep(user.id, step)));

    expect(claims.filter(Boolean)).toHaveLength(1);
    expect(await claimTwoFactorStep(user.id, step)).toBe(false);
  });

  test("refuses a code older than the last one used", async () => {
    const { user, secret } = await userWithTwoFactor();

    const first = await signInWithPassword(user.email);
    (
      await first.post("/two-factor/challenge", { code: authenticator.generateCode(secret) })
    ).assertRedirect("/dashboard");

    // The previous step's code is still inside the window, but it is older than the
    // code just accepted.
    const second = await signInWithPassword(user.email);
    (
      await second.post("/two-factor/challenge", { code: authenticator.generateCode(secret, -1) })
    ).assertInvalid(["code"]);
  });

  test("rejects a wrong code", async () => {
    const { user } = await userWithTwoFactor();
    const browser = await signInWithPassword(user.email);

    (await browser.post("/two-factor/challenge", { code: "000000" })).assertInvalid(["code"]);
    (await browser.get("/dashboard")).assertRedirect("/login");
  });

  test("signs in with a recovery code, which then stops working", async () => {
    const { user, recoveryCodes } = await userWithTwoFactor();
    const code = recoveryCodes[0]!;

    const first = await signInWithPassword(user.email);
    (await first.post("/two-factor/challenge", { recovery_code: code })).assertRedirect(
      "/dashboard",
    );

    const second = await signInWithPassword(user.email);
    (await second.post("/two-factor/challenge", { recovery_code: code })).assertInvalid([
      "recovery_code",
    ]);
  });

  test("sends a visitor with nothing pending back to sign in", async () => {
    (await app.get("/two-factor/challenge")).assertRedirect("/login");
  });
});

describe("managing two-factor", () => {
  refreshDatabase();

  const confirmed = () => ({ [PASSWORD_CONFIRMED_AT_KEY]: Date.now() });

  test("makes new recovery codes, and the old ones stop working", async () => {
    const { user } = await userWithTwoFactor();
    const before = (await User.find(user.id))!.twoFactorRecoveryCodes;

    const res = await app
      .actingAs(user)
      .withSession(confirmed())
      .postForm("/settings/two-factor/recovery-codes", {});

    res.assertRedirect("/settings/two-factor");
    expect((await User.find(user.id))!.twoFactorRecoveryCodes).not.toBe(before);
  });

  test("turns two-factor off", async () => {
    const { user } = await userWithTwoFactor();

    const res = await app
      .actingAs(user)
      .withSession(confirmed())
      .request("/settings/two-factor", { method: "DELETE" });

    res.assertRedirect("/settings/two-factor");
    expect((await User.find(user.id))?.hasTwoFactorEnabled()).toBe(false);
  });
});
