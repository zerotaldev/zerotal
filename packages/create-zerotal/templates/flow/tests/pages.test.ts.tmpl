/**
 * Every page is built once, to prove it can be.
 *
 * The rest of the suite asserts status codes and what a page says, and only for the
 * states a request can reach in a line or two. A page can still throw on its first paint
 * in a state nobody requested — two-factor half set up, a list with one project in it —
 * and every other test passes. This builds each page, in its layout, in those states too.
 *
 * It proves one thing only: the page and its layout render without throwing. It is not a
 * browser — nothing runs resources/js/app.js, and nothing clicks; for that, see
 * `@zerotal/testing/browser`.
 *
 * Add a line when you add a page. The cost is one line and the bug it catches is a
 * broken page your users find first.
 */
import { afterAll, beforeAll, describe, expect, test } from "bun:test";
import { refreshDatabase, type HtmlDocument, type TestApp } from "zerotal/testing";
import type { Page } from "../app/flow/lib/page";
import { ProjectFactory } from "../database/factories/ProjectFactory";
import { UserFactory } from "../database/factories/UserFactory";
import { renderPage } from "./render";
import { bootApp } from "./support";

import { AboutPage } from "../app/flow/pages/about";
import { ErrorPage } from "../app/flow/pages/error";
import { HomePage } from "../app/flow/pages/home";
import { ConfirmPasswordPage } from "../app/flow/pages/auth/confirm-password";
import { ForgotPasswordPage } from "../app/flow/pages/auth/forgot-password";
import { LoginPage } from "../app/flow/pages/auth/login";
import { RegisterPage } from "../app/flow/pages/auth/register";
import { ResetPasswordPage } from "../app/flow/pages/auth/reset-password";
import { TwoFactorChallengePage } from "../app/flow/pages/auth/two-factor-challenge";
import { VerifyEmailPage } from "../app/flow/pages/auth/verify-email";
import { DashboardPage } from "../app/flow/pages/dashboard";
import { CreateProjectPage } from "../app/flow/pages/projects/create";
import { EditProjectPage } from "../app/flow/pages/projects/edit";
import { ProjectsPage } from "../app/flow/pages/projects/index";
import { AppearancePage } from "../app/flow/pages/settings/appearance";
import { DeleteAccountPage } from "../app/flow/pages/settings/delete-account";
import { PasskeysPage } from "../app/flow/pages/settings/passkeys";
import { PasswordPage } from "../app/flow/pages/settings/password";
import { ProfilePage } from "../app/flow/pages/settings/profile";
import { SessionsPage } from "../app/flow/pages/settings/sessions";
import { TwoFactorPage } from "../app/flow/pages/settings/two-factor";

// The pages read the database and the config, so the app is booted for them.
let app: TestApp;

beforeAll(async () => {
  app = await bootApp();
});
afterAll(() => app.close());

// A page class, with the state to lay over it. Typed loosely on purpose: the list mixes
// every page in the app, and each entry's state is checked by the page it is given to.
// eslint-disable-next-line @typescript-eslint/no-explicit-any
type PageCase = [name: string, page: any, state: Record<string, unknown>];

const PUBLIC: PageCase[] = [
  ["home", HomePage, {}],
  ["about", AboutPage, {}],
  ["error", ErrorPage, { status: 404 }],
  ["error", ErrorPage, { status: 419 }],
  ["auth/login", LoginPage, {}],
  ["auth/register", RegisterPage, {}],
  ["auth/forgot-password", ForgotPasswordPage, {}],
  ["auth/reset-password", ResetPasswordPage, { token: "test-token", email: "ada@example.com" }],
  ["auth/two-factor-challenge", TwoFactorChallengePage, {}],
];

/** The markup a page and its layout built: enough to show something real came out. */
function expectAPage(page: HtmlDocument): void {
  page.assertPresent("[data-flow-layout]");
  expect(page.getByRole("main").text()).not.toBe("");
}

describe("pages render", () => {
  refreshDatabase();

  for (const [name, PageClass, state] of PUBLIC) {
    test(`${name} builds without throwing`, async () => {
      expectAPage(await renderPage<Page>(PageClass, { url: `/${name}`, state }));
    });
  }
});

/**
 * The signed-in pages, rendered with a user — they read `this.user`, and the sidebar shows
 * it. A page that only ever renders as a guest has had half of it tested.
 */
const PROJECT = {
  id: 1,
  name: "Website relaunch",
  description: "A new site.",
  status: "active",
  updatedAt: "2026-01-01T00:00:00.000Z",
};

const SIGNED_IN: PageCase[] = [
  ["dashboard", DashboardPage, {}],
  [
    "dashboard",
    DashboardPage,
    { stats: { total: 1, active: 1, completed: 0 }, recentProjects: [PROJECT] },
  ],
  ["projects/index", ProjectsPage, {}],
  ["projects/index", ProjectsPage, { search: "nothing matches this" }],
  ["projects/create", CreateProjectPage, {}],
  ["auth/verify-email", VerifyEmailPage, {}],
  ["auth/confirm-password", ConfirmPasswordPage, {}],
  ["settings/profile", ProfilePage, {}],
  ["settings/password", PasswordPage, {}],
  ["settings/appearance", AppearancePage, {}],
  ["settings/two-factor", TwoFactorPage, {}],
  [
    "settings/two-factor",
    TwoFactorPage,
    { setup: { qrSvg: "<svg></svg>", uri: "otpauth://totp/x", secret: "JBSWY3DPEHPK3PXP" } },
  ],
  [
    "settings/two-factor",
    TwoFactorPage,
    { enabled: true, recoveryCodes: ["aaaa-bbbb"], recoveryCodesLeft: 8 },
  ],
  [
    "settings/passkeys",
    PasskeysPage,
    {
      passkeys: [
        {
          id: 1,
          name: "Mac",
          deviceType: "multiDevice",
          backedUp: true,
          createdAt: "2026-01-01T00:00:00.000Z",
          lastUsedAt: null,
        },
      ],
    },
  ],
  [
    "settings/sessions",
    SessionsPage,
    {
      sessions: [
        {
          id: "a",
          browser: "Chrome",
          platform: "macOS",
          ipAddress: "127.0.0.1",
          lastActiveAt: "2026-01-01T00:00:00.000Z",
          current: true,
        },
      ],
    },
  ],
  ["settings/delete-account", DeleteAccountPage, {}],
  ["error", ErrorPage, { status: 403 }],
];

describe("pages render for a signed-in user", () => {
  refreshDatabase();

  for (const [name, PageClass, state] of SIGNED_IN) {
    test(`${name} builds with a user`, async () => {
      const user = await UserFactory.create({ name: "Ada Lovelace" });
      expectAPage(await renderPage<Page>(PageClass, { user, url: `/${name}`, state }));
    });
  }

  // The list and the edit form read real rows, so these two get a project of their own.
  test("projects/index builds with a user and a project", async () => {
    const user = await UserFactory.create();
    await ProjectFactory.for(user).create({ name: "Website relaunch" });

    const page = await renderPage(ProjectsPage, { user, url: "/projects" });
    page.getByRole("link", { name: "Website relaunch" });
  });

  test("projects/edit builds with a user", async () => {
    const user = await UserFactory.create();
    const project = await ProjectFactory.for(user).create({ name: "Website relaunch" });

    const page = await renderPage(EditProjectPage, {
      user,
      url: `/projects/${project.id}/edit`,
      state: { project },
    });
    page.assertValue("name", "Website relaunch");
  });
});
