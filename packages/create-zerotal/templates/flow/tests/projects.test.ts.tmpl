import { afterAll, beforeAll, beforeEach, describe, expect, test } from "bun:test";
import {
  assertDatabaseHas,
  assertDatabaseMissing,
  refreshDatabase,
  type HtmlDocument,
  type TestApp,
} from "zerotal/testing";
import { Project } from "../app/models/Project";
import { ProjectFactory } from "../database/factories/ProjectFactory";
import { UserFactory } from "../database/factories/UserFactory";
import { assertPage, bootApp } from "./support";

/** The names in the projects list, in the order it shows them. */
function projectNames(page: HtmlDocument): string[] {
  return page
    .getByRole("list", { name: "Projects" })
    .findAllByRole("listitem")
    .map((item) => item.get("a").text());
}

/**
 * The example resource, end to end: every action a user takes on a project, and the
 * policy that keeps one user's projects from another. Delete this file with the rest
 * of the example (see "Remove the example" in the README).
 */
let app: TestApp;

beforeAll(async () => {
  app = await bootApp();
});
afterAll(() => app.close());
beforeEach(() => app.actingAsGuest());

const valid = { name: "Website relaunch", description: "A new site.", status: "active" };

describe("projects", () => {
  refreshDatabase();

  test("keeps projects behind a sign-in", async () => {
    (await app.get("/projects")).assertRedirect("/login");
  });

  test("lists only the signed-in user’s projects", async () => {
    const user = await UserFactory.create();
    const other = await UserFactory.create();
    await ProjectFactory.for(user).count(2).create();
    await ProjectFactory.for(other).create({ name: "Not yours" });

    const projects = projectNames(
      assertPage(await app.actingAs(user).get("/projects"), "Projects"),
    );

    expect(projects).toHaveLength(2);
    expect(projects).not.toContain("Not yours");
  });

  test("searches by name and description", async () => {
    const user = await UserFactory.create();
    await ProjectFactory.for(user).create({ name: "Billing migration", description: "Invoices." });
    await ProjectFactory.for(user).create({
      name: "Status page",
      description: "Uptime and billing incidents.",
    });
    await ProjectFactory.for(user).create({ name: "Dark mode", description: "Themes." });

    const page = (await app.actingAs(user).get("/projects?search=billing")).assertOk().html();

    expect(projectNames(page).sort()).toEqual(["Billing migration", "Status page"]);
    // What was searched for stays in the box.
    page.assertValue("search", "billing");
  });

  test("pages through a long list", async () => {
    const user = await UserFactory.create();
    await ProjectFactory.for(user).count(12).create();

    const second = (await app.actingAs(user).get("/projects?page=2")).assertOk().html();

    expect(projectNames(second)).toHaveLength(2);
    second
      .getByRole("navigation", { name: "Pagination" })
      .assertSeeText("Showing 11–12 of 12 projects")
      .assertPresent('a[rel="prev"]')
      .assertMissing('a[rel="next"]');
  });

  test("creates a project owned by the signed-in user", async () => {
    const user = await UserFactory.create();

    assertPage(await app.actingAs(user).get("/projects/create"), "New project").assertFormAction(
      "/projects",
      "POST",
    );
    const res = await app.actingAs(user).postForm("/projects", valid);

    res.assertRedirect("/projects");
    res.assertSessionHas("success");
    await assertDatabaseHas("projects", {
      name: "Website relaunch",
      user_id: user.id,
      status: "active",
    });
  });

  test("rejects an invalid project", async () => {
    const user = await UserFactory.create();

    const res = await app
      .actingAs(user)
      .postForm(
        "/projects",
        { name: "x", status: "nonsense" },
        { Referer: `${app.baseUrl}/projects/create` },
      );

    res.assertRedirect("/projects/create");
    res.assertInvalid(["name", "status"]);
    await assertDatabaseMissing("projects", { name: "x" });
  });

  test("ignores an owner sent with the form", async () => {
    const user = await UserFactory.create();
    const other = await UserFactory.create();

    await app
      .actingAs(user)
      .postForm("/projects", { ...valid, user_id: other.id, userId: other.id });

    await assertDatabaseHas("projects", { name: valid.name, user_id: user.id });
  });

  test("edits a project", async () => {
    const user = await UserFactory.create();
    const project = await ProjectFactory.for(user).create();

    assertPage(await app.actingAs(user).get(`/projects/${project.id}/edit`), `Edit ${project.name}`)
      .assertValue("name", project.name)
      .assertFormAction(`/projects/${project.id}`);
    const res = await app
      .actingAs(user)
      .putForm(`/projects/${project.id}`, { ...valid, name: "Renamed" });

    res.assertRedirect("/projects");
    expect((await Project.find(project.id))?.name).toBe("Renamed");
  });

  test("deletes a project", async () => {
    const user = await UserFactory.create();
    const project = await ProjectFactory.for(user).create();

    (await app.actingAs(user).delete(`/projects/${project.id}`)).assertRedirect("/projects");

    expect(await Project.find(project.id)).toBeNull();
  });

  test("answers 404 for a project that does not exist", async () => {
    const user = await UserFactory.create();

    (await app.actingAs(user).get("/projects/999999/edit")).assertNotFound();
  });

  test("forbids another user from seeing, changing or deleting a project", async () => {
    const owner = await UserFactory.create();
    const stranger = await UserFactory.create();
    const project = await ProjectFactory.for(owner).create({ name: "Private" });

    (await app.actingAs(stranger).get(`/projects/${project.id}/edit`)).assertForbidden();
    (await app.actingAs(stranger).putForm(`/projects/${project.id}`, valid)).assertForbidden();
    (await app.actingAs(stranger).delete(`/projects/${project.id}`)).assertForbidden();

    expect((await Project.find(project.id))?.name).toBe("Private");
  });

  test("shows the project counts on the dashboard", async () => {
    const user = await UserFactory.create();
    await ProjectFactory.for(user).create({ status: "active" });
    await ProjectFactory.for(user).create({ status: "completed" });

    const dashboard = (await app.actingAs(user).get("/dashboard")).assertOk().html();
    const stat = (name: string) => dashboard.getByRole("group", { name }).text();

    expect([stat("Projects"), stat("Active"), stat("Completed")]).toEqual([
      "Projects 2",
      "Active 1",
      "Completed 1",
    ]);
  });
});
