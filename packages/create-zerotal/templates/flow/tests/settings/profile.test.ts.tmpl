import { afterAll, afterEach, beforeAll, beforeEach, describe, expect, test } from "bun:test";
import { NotificationFake } from "@zerotal/notifications";
import { refreshDatabase, type TestApp } from "zerotal/testing";
import { User } from "../../app/models/User";
import { VerifyEmailNotification } from "../../app/notifications/VerifyEmailNotification";
import { UserFactory } from "../../database/factories/UserFactory";
import { assertPage, bootApp } from "../support";

let app: TestApp;
let mail: NotificationFake;

beforeAll(async () => {
  app = await bootApp();
});
afterAll(() => app.close());
beforeEach(() => {
  app.actingAsGuest();
  mail = NotificationFake.install();
});
afterEach(() => mail.restore());

describe("profile settings", () => {
  refreshDatabase();

  test("opens settings on the profile page", async () => {
    const user = await UserFactory.create();

    (await app.actingAs(user).get("/settings")).assertRedirect("/settings/profile");
    assertPage(await app.actingAs(user).get("/settings/profile"), "Profile")
      .assertValue("name", user.name)
      .assertValue("email", user.email);
  });

  test("updates the name", async () => {
    const user = await UserFactory.create();

    const res = await app
      .actingAs(user)
      .patchForm("/settings/profile", { name: "Ada King", email: user.email });

    res.assertRedirect("/settings/profile");
    expect((await User.find(user.id))?.name).toBe("Ada King");
    mail.assertNothingSent();
  });

  test("changing the email asks for it to be verified again", async () => {
    const user = await UserFactory.create();

    await app
      .actingAs(user)
      .patchForm("/settings/profile", { name: user.name, email: "new@example.com" });

    const fresh = (await User.find(user.id))!;
    expect(fresh.email).toBe("new@example.com");
    expect(fresh.hasVerifiedEmail()).toBe(false);
    mail.assertSentTo(fresh, VerifyEmailNotification);
  });

  test("refuses an email another account uses", async () => {
    const user = await UserFactory.create();
    const other = await UserFactory.create();

    const res = await app
      .actingAs(user)
      .patchForm("/settings/profile", { name: user.name, email: other.email });

    res.assertInvalid(["email"]);
    expect((await User.find(user.id))?.email).toBe(user.email);
  });
});
