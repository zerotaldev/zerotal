{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "emitDecoratorMetadata": false,
    "jsx": "react-jsx",
    "jsxImportSource": "zerotal",
    "skipLibCheck": true,
    "paths": {
      "@app/*": [
        "./app/*"
      ],
      "@pages/*": [
        "./resources/js/pages/*"
      ]
    },
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["**/*"],
  "exclude": [
    "node_modules",
    ".zerotal"
  ]
}
