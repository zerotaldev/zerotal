import { afterAll, beforeAll, beforeEach, describe, test } from "bun:test";
import { refreshDatabase, type TestApp } from "zerotal/testing";
import { FACTORY_PASSWORD, UserFactory } from "../../database/factories/UserFactory";
import { Browser, bootApp } from "../support";

let app: TestApp;

beforeAll(async () => {
  app = await bootApp();
});
afterAll(() => app.close());
beforeEach(() => app.actingAsGuest());

describe("password confirmation", () => {
  refreshDatabase();

  test("asks for the password before two-factor settings", async () => {
    const user = await UserFactory.create();

    (await app.actingAs(user).get("/settings/two-factor")).assertRedirect("/confirm-password");
  });

  test("lets the user through once the password is confirmed", async () => {
    const user = await UserFactory.create();
    const browser = new Browser(app);
    await browser.post("/login", { email: user.email, password: FACTORY_PASSWORD });

    (await browser.get("/settings/two-factor")).assertRedirect("/confirm-password");
    (await browser.post("/confirm-password", { password: FACTORY_PASSWORD })).assertRedirect(
      "/settings/two-factor",
    );
    (await browser.get("/settings/two-factor")).assertOk().assertInertia("settings/two-factor");
  });

  test("rejects a wrong password", async () => {
    const user = await UserFactory.create();

    const res = await app.actingAs(user).postForm("/confirm-password", { password: "wrong" });

    res.assertRedirect("/confirm-password");
    res.assertInvalid(["password"]);
  });
});
