import { afterAll, afterEach, beforeAll, beforeEach, describe, test } from 'bun:test';
import { NotificationFake } from '@zerotal/notifications';
import { refreshDatabase, type TestApp } from 'zerotal/testing';
import { ResetPasswordNotification } from '../../app/notifications/ResetPasswordNotification';
import { UserFactory } from '../../database/factories/UserFactory';
import { bootApp } from '../support';

let app: TestApp;
let mail: NotificationFake;

beforeAll(async () => {
  app = await bootApp();
});
afterAll(() => app.close());
beforeEach(() => {
  app.actingAsGuest();
  mail = NotificationFake.install();
});
afterEach(() => mail.restore());

/** The emailed reset link, as a path with its query string. */
function emailedLink(): string {
  const sent = mail.sent().find((s) => s.notification instanceof ResetPasswordNotification);
  if (!sent) throw new Error('no reset email was sent');
  const url = new URL((sent.notification as ResetPasswordNotification).url());
  return url.pathname + url.search;
}

describe('password reset', () => {
  refreshDatabase();

  test('emails a reset link to a registered address', async () => {
    const user = await UserFactory.create();

    (await app.postForm('/forgot-password', { email: user.email })).assertRedirect('/forgot-password');

    mail.assertSentTo(user, ResetPasswordNotification);
  });

  test('answers the same for an unknown address', async () => {
    const res = await app.postForm('/forgot-password', { email: 'nobody@example.com' });

    res.assertRedirect('/forgot-password');
    mail.assertNothingSent();
  });

  test('resets the password with the emailed link', async () => {
    const user = await UserFactory.create();
    await app.postForm('/forgot-password', { email: user.email });
    const link = new URL(emailedLink(), app.baseUrl);

    (await app.get(link.pathname + link.search)).assertOk().assertInertia('auth/reset-password');

    const res = await app.postForm('/reset-password', {
      email: user.email,
      token: link.searchParams.get('token') ?? '',
      password: 'a-brand-new-password',
      password_confirmation: 'a-brand-new-password',
    });
    res.assertRedirect('/login');

    (await app.postForm('/login', { email: user.email, password: 'a-brand-new-password' })).assertRedirect('/dashboard');
  });

  test('rejects an invalid token', async () => {
    const user = await UserFactory.create();

    const res = await app.postForm('/reset-password', {
      email: user.email,
      token: 'not-a-real-token',
      password: 'a-brand-new-password',
      password_confirmation: 'a-brand-new-password',
    });

    res.assertInvalid(['email']);
  });
});
