/**
 * Every page is built once, to prove it can be.
 *
 * The rest of the suite asserts values and status codes, and a page can throw on
 * its first paint while every one of them passes: the route answers `200`, the
 * Inertia payload is correct, and the failure happens in a browser the test never
 * opened. An app shipped a blank page to production with 614 green tests exactly
 * that way — a layout callback read `page.props`, which the callback is not given.
 *
 * This proves one thing only: the component tree builds without throwing. That is
 * precisely the thing nothing else here checks. It is not a DOM — `useEffect` does
 * not run, and nothing clicks; for that, see `@zerotal/testing/browser`.
 *
 * Add a line when you add a page. The cost is one line and the bug it catches is a
 * white screen your users find first.
 */
import { describe, test } from "bun:test";
import { renderPage } from "@zerotal/inertia/testing";
import { defineRoutes } from "zerotal/routes";
import { ROUTES } from "../types/routes.generated";

import About from "../resources/js/pages/about";
import Contact from "../resources/js/pages/contact";
import ErrorPage from "../resources/js/pages/error";
import Home from "../resources/js/pages/home";
import ConfirmPassword from "../resources/js/pages/auth/confirm-password";
import ForgotPassword from "../resources/js/pages/auth/forgot-password";
import Login from "../resources/js/pages/auth/login";
import Register from "../resources/js/pages/auth/register";
import ResetPassword from "../resources/js/pages/auth/reset-password";
import TwoFactorChallenge from "../resources/js/pages/auth/two-factor-challenge";
import VerifyEmail from "../resources/js/pages/auth/verify-email";
import Dashboard from "../resources/js/pages/dashboard";
import CreateProject from "../resources/js/pages/projects/create";
import EditProject from "../resources/js/pages/projects/edit";
import Projects from "../resources/js/pages/projects/index";
import SettingsAppearance from "../resources/js/pages/settings/appearance";
import SettingsDeleteAccount from "../resources/js/pages/settings/delete-account";
import SettingsPasskeys from "../resources/js/pages/settings/passkeys";
import SettingsPassword from "../resources/js/pages/settings/password";
import SettingsProfile from "../resources/js/pages/settings/profile";
import SettingsSessions from "../resources/js/pages/settings/sessions";
import SettingsTwoFactor from "../resources/js/pages/settings/two-factor";

// The same line `resources/js/app.tsx` runs in the browser. `defineRoutes` installs
// `route()` as a global, and the layouts call it — so without this every page throws
// `route is not defined`, which is a true statement about a test that has not
// finished setting up rather than about the page.
defineRoutes(ROUTES);

/**
 * What `Inertia.share()` puts on every page. A component that destructures one of
 * these throws without it — a real failure, but not the one these tests are for.
 * Keep this in step with `resources/js/types.ts`.
 */
const SHARED = {
  app: { name: "Acme" },
  features: { passkeys: true },
  auth: { user: null },
  flash: { success: null, error: null, warning: null, info: null },
  errors: {},
  old: {},
};

type PageCase = [name: string, page: unknown, props: Record<string, unknown>];

const PUBLIC: PageCase[] = [
  ["home", Home, { title: "Home", message: "Welcome" }],
  ["about", About, { title: "About" }],
  ["contact", Contact, { title: "Contact" }],
  ["error", ErrorPage, { status: 404 }],
  ["auth/login", Login, { title: "Sign in", passkeys: true, providers: ["github", "google"] }],
  ["auth/register", Register, { title: "Create an account", providers: ["github"] }],
  ["auth/forgot-password", ForgotPassword, { title: "Forgot password" }],
  [
    "auth/reset-password",
    ResetPassword,
    { title: "Reset password", token: "test-token", email: "ada@example.com" },
  ],
  ["auth/two-factor-challenge", TwoFactorChallenge, { title: "Two-factor authentication" }],
];

describe("pages render", () => {
  for (const [name, Page, props] of PUBLIC) {
    test(`${name} builds without throwing`, async () => {
      await renderPage(Page, props, { shared: SHARED, url: `/${name}` });
    });
  }
});

