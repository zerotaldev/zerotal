import { afterAll, beforeAll, beforeEach, describe, test } from "bun:test";
import { refreshDatabase, type TestApp } from "zerotal/testing";
import { FACTORY_PASSWORD, UserFactory } from "../../database/factories/UserFactory";
import { Browser, bootApp } from "../support";

let app: TestApp;

beforeAll(async () => {
  app = await bootApp();
});
afterAll(() => app.close());
beforeEach(() => app.actingAsGuest());

describe("password settings", () => {
  refreshDatabase();

  test("changes the password, and the old one stops working", async () => {
    const user = await UserFactory.create();

    const res = await app.actingAs(user).putForm("/settings/password", {
      current_password: FACTORY_PASSWORD,
      password: "a-brand-new-password",
      password_confirmation: "a-brand-new-password",
    });
    res.assertRedirect("/settings/password");

    app.actingAsGuest();
    (
      await app.postForm("/login", { email: user.email, password: FACTORY_PASSWORD })
    ).assertSessionMissing("user_id");
    (
      await app.postForm("/login", { email: user.email, password: "a-brand-new-password" })
    ).assertRedirect("/dashboard");
  });

  test("keeps this browser signed in after the change", async () => {
    const user = await UserFactory.create();
    const browser = new Browser(app);
    await browser.post("/login", { email: user.email, password: FACTORY_PASSWORD });

    await browser.put("/settings/password", {
      current_password: FACTORY_PASSWORD,
      password: "a-brand-new-password",
      password_confirmation: "a-brand-new-password",
    });

    (await browser.get("/settings/password")).assertOk();
  });

  test("refuses a wrong current password", async () => {
    const user = await UserFactory.create();

    const res = await app.actingAs(user).putForm("/settings/password", {
      current_password: "wrong",
      password: "a-brand-new-password",
      password_confirmation: "a-brand-new-password",
    });

    res.assertInvalid(["current_password"]);
  });
});
