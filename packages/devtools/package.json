{
  "name": "@zerotal/devtools",
  "version": "1.7.4",
  "license": "MIT",
  "maturity": "stable",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts"
  },
  "files": [
    "CHANGELOG.md",
    "api-surface.md",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.spec.ts",
    "!src/**/__fixtures__/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zerotal/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@zerotal/orm": "workspace:*"
  },
  "description": "In-browser developer tools for Zerotal — request traces, an inspector panel, and an extensible tab registry.",
  "keywords": [
    "zerotal",
    "bun",
    "typescript",
    "framework"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerotaldev/zerotal.git",
    "directory": "packages/devtools"
  },
  "homepage": "https://github.com/zerotaldev/zerotal/tree/main/packages/devtools#readme",
  "bugs": "https://github.com/zerotaldev/zerotal/issues"
}
