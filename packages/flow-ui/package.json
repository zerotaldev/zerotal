{
  "name": "@zerotal/flow-ui",
  "version": "1.3.0",
  "license": "MIT",
  "maturity": "experimental",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./theme.css",
    "./commands": "./src/commands/index.ts",
    "./registry": "./src/registry.ts"
  },
  "files": [
    "CHANGELOG.md",
    "src",
    "theme.css",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.spec.ts",
    "!src/**/__fixtures__/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "docs:gen": "bun scripts/generate-docs.ts"
  },
  "dependencies": {
    "@zerotal/core": "workspace:*",
    "@zerotal/flow": "workspace:*",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "typescript": "^5.8.0"
  },
  "description": "Copy-in UI component registry for Flow (Zerotal's reactive SSR layer).",
  "keywords": [
    "zerotal",
    "bun",
    "typescript",
    "framework"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerotaldev/zerotal.git",
    "directory": "packages/flow-ui"
  },
  "homepage": "https://github.com/zerotaldev/zerotal/tree/main/packages/flow-ui#readme",
  "bugs": "https://github.com/zerotaldev/zerotal/issues"
}
