{
  "name": "@zerotal/flow",
  "version": "1.10.0",
  "license": "MIT",
  "maturity": "stable",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-dev-runtime.ts",
    "./compiler-helpers": "./src/compiler/helpers.ts",
    "./store": "./src/store.ts",
    "./testing": "./src/testing.ts",
    "./browser": "./src/browser/index.ts"
  },
  "files": [
    "CHANGELOG.md",
    "api-surface.md",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.spec.ts",
    "!src/**/__fixtures__/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "sideEffects": [
    "./src/augment.ts",
    "./src/synths/*.ts"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@alpinejs/anchor": "^3.14.9",
    "@alpinejs/collapse": "^3.14.9",
    "@alpinejs/focus": "^3.14.9",
    "@alpinejs/mask": "^3.14.9",
    "@alpinejs/morph": "^3.14.9",
    "@alpinejs/persist": "^3.14.9",
    "@alpinejs/resize": "^3.14.9",
    "@zerotal/client": "workspace:*",
    "@zerotal/core": "workspace:*",
    "@zerotal/orm": "workspace:*",
    "@zerotal/validator": "workspace:*",
    "alpinejs": "^3.14.9",
    "typescript": "^5.8.0"
  },
  "devDependencies": {
    "@zerotal/broadcasting": "workspace:*",
    "@types/alpinejs": "^3.13.10",
    "@types/alpinejs__anchor": "^3.13.1",
    "@types/alpinejs__collapse": "^3.13.4",
    "@types/alpinejs__focus": "^3.13.4",
    "@types/alpinejs__mask": "^3.13.4",
    "@types/alpinejs__persist": "^3.13.4",
    "@types/alpinejs__resize": "^3.14.0",
    "bun-types": "^1.3.14"
  },
  "description": "Flow (experimental) — server-driven reactive UI for Zerotal with signed snapshots, delta transport, and real-time primitives.",
  "keywords": [
    "zerotal",
    "bun",
    "typescript",
    "framework",
    "reactive",
    "ssr",
    "websocket",
    "server-driven"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerotaldev/zerotal.git",
    "directory": "packages/flow"
  },
  "homepage": "https://github.com/zerotaldev/zerotal/tree/main/packages/flow#readme",
  "bugs": "https://github.com/zerotaldev/zerotal/issues"
}
