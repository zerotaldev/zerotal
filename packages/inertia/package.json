{
  "name": "@zerotal/inertia",
  "version": "1.12.0",
  "license": "MIT",
  "maturity": "stable",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "files": [
    "CHANGELOG.md",
    "api-surface.md",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.spec.ts",
    "!src/**/__fixtures__/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "sideEffects": [
    "./src/augment.ts"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zerotal/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "vue": "^3",
    "@inertiajs/react": "^1 || ^2 || ^3",
    "@inertiajs/vue3": "^1 || ^2 || ^3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@inertiajs/react": {
      "optional": true
    },
    "@inertiajs/vue3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@inertiajs/react": "^3.7.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.8.0"
  },
  "description": "Inertia.js adapter for Zerotal — server-driven React/Vue single-page apps.",
  "keywords": [
    "zerotal",
    "bun",
    "typescript",
    "framework"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerotaldev/zerotal.git",
    "directory": "packages/inertia"
  },
  "homepage": "https://github.com/zerotaldev/zerotal/tree/main/packages/inertia#readme",
  "bugs": "https://github.com/zerotaldev/zerotal/issues"
}
