{
  "name": "@zerotal/media",
  "version": "1.6.0",
  "license": "MIT",
  "maturity": "stable",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./commands": "./src/commands/index.ts",
    "./testing": "./src/testing.ts"
  },
  "files": [
    "CHANGELOG.md",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.spec.ts",
    "!src/**/__fixtures__/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zerotal/core": "workspace:*",
    "@zerotal/orm": "workspace:*"
  },
  "peerDependencies": {
    "@zerotal/queue": "^1.0.0",
    "sharp": "^0.33 || ^0.34"
  },
  "peerDependenciesMeta": {
    "@zerotal/queue": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@zerotal/queue": "workspace:*",
    "sharp": "^0.34.0",
    "typescript": "^5.8.0"
  },
  "description": "Attach files to models: media collections, image conversions, responsive images, and ordering — on any Zerotal storage disk.",
  "keywords": [
    "zerotal",
    "bun",
    "typescript",
    "framework",
    "media",
    "uploads",
    "images"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerotaldev/zerotal.git",
    "directory": "packages/media"
  },
  "homepage": "https://github.com/zerotaldev/zerotal/tree/main/packages/media#readme",
  "bugs": "https://github.com/zerotaldev/zerotal/issues"
