    "@zerotal/queue": "workspace:*",
    "@zerotal/scheduler": "workspace:*",
    "@zerotal/telemetry": "workspace:*"
  },
  "peerDependencies": {
    "@zerotal/queue": "^1.0.0",
    "@zerotal/scheduler": "^1.0.0",
    "@zerotal/telemetry": "^1.0.0"
