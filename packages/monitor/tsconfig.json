{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "rootDir": "..",
    "outDir": "./.tsbuild",
    "tsBuildInfoFile": "./.tsbuild/.tsbuildinfo",
    "jsx": "react-jsx",
    "jsxImportSource": "@zerotal/flow",
    "paths": {
      "@zerotal/core": ["../core/src/index.ts"],
      "@zerotal/flow": ["../flow/src/index.ts"],
      "@zerotal/flow/jsx-runtime": ["../flow/src/jsx-runtime.ts"],
      "@zerotal/queue": ["../queue/src/index.ts"],
      "@zerotal/scheduler": ["../scheduler/src/index.ts"],
      "@zerotal/telemetry": ["../telemetry/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", ".tsbuild", "**/*.test.ts", "**/*.test.tsx"]
}
