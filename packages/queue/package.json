{
  "name": "@zerotal/queue",
  "version": "1.1.0",
  "license": "MIT",
  "maturity": "stable",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./commands": "./src/commands/index.ts"
  },
  "files": [
