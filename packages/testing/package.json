{
  "name": "@zerotal/testing",
  "version": "1.0.2",
  "license": "MIT",
  "maturity": "stable",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./preload": "./src/preload.ts"
  },
  "files": [
    "CHANGELOG.md",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.spec.ts",
    "!src/**/__fixtures__/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zerotal/core": "workspace:*",
    "@zerotal/orm": "workspace:*",
    "@zerotal/queue": "workspace:*",
    "@zerotal/notifications": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@zerotal/session": "workspace:*"
  },
  "description": "Testing utilities for Zerotal — an in-process test app, HTTP helpers, and database refresh.",
  "keywords": [
    "zerotal",
    "bun",
    "typescript",
    "framework"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerotaldev/zerotal.git",
    "directory": "packages/testing"
  },
  "homepage": "https://github.com/zerotaldev/zerotal/tree/main/packages/testing#readme",
  "bugs": "https://github.com/zerotaldev/zerotal/issues"
}
