{
  "name": "zerotal",
  "version": "1.13.5",
  "license": "MIT",
  "maturity": "stable",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./assets": "./src/assets.ts",
    "./auth": "./src/auth.ts",
    "./build": "./src/build.ts",
    "./cache": "./src/cache.ts",
    "./carbon": "./src/carbon.ts",
    "./client": "./src/client.ts",
    "./commands": "./src/commands.ts",
    "./config": "./src/config-reexport.ts",
    "./contracts": "./src/contracts.ts",
    "./dev": "./src/dev.ts",
    "./env": "./src/env.ts",
    "./facades": "./src/facades.ts",
    "./health": "./src/health.ts",
    "./helpers": "./src/helpers.ts",
    "./http": "./src/http.ts",
    "./jsx-dev-runtime": "./src/jsx-dev-runtime.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./lock": "./src/lock.ts",
    "./logger": "./src/logger.ts",
    "./media": "./src/media.ts",
    "./metrics": "./src/metrics.ts",
    "./orm": "./src/orm.ts",
    "./queue": "./src/queue.ts",
    "./routes": "./src/routes.ts",
    "./runtime": "./src/runtime.ts",
    "./scheduler": "./src/scheduler.ts",
    "./security": "./src/security.ts",
    "./session": "./src/session.ts",
    "./shared": "./src/shared.ts",
    "./storage": "./src/storage.ts",
    "./testing": "./src/testing.ts",
    "./validator": "./src/validator.ts",
    "./view": "./src/view.ts"
  },
  "files": [
    "CHANGELOG.md",
    "api-surface.md",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.spec.ts",
    "!src/**/__fixtures__/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zerotal/auth": "workspace:*",
    "@zerotal/cache": "workspace:*",
    "@zerotal/client": "workspace:*",
    "@zerotal/core": "workspace:*",
    "@zerotal/media": "workspace:*",
    "@zerotal/orm": "workspace:*",
    "@zerotal/queue": "workspace:*",
    "@zerotal/scheduler": "workspace:*",
    "@zerotal/session": "workspace:*",
    "@zerotal/testing": "workspace:*",
    "@zerotal/validator": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "description": "Zerotal, one install — the meta package re-exporting @zerotal/core and the stable set.",
  "keywords": [
    "zerotal",
    "bun",
    "typescript",
    "framework"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerotaldev/zerotal.git",
    "directory": "packages/zerotal"
  },
  "homepage": "https://github.com/zerotaldev/zerotal/tree/main/packages/zerotal#readme",
  "bugs": "https://github.com/zerotaldev/zerotal/issues"
}
